<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:svc="using:BasisPM.Core.Services"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.ProjectFilesWindow"
        x:DataType="vm:ProjectFilesViewModel"
        Title="{loc:Tr bpm.title}"
        Width="900" Height="760" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <DockPanel Margin="26,24">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Heading}" Classes="h3" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Tr bpm.intro}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BasisDevText}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Button Classes="iconBtn" Command="{Binding OpenBasisDevCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.openBasisDev}">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconFolderOpen}"/>
                    </Button>
                    <Button Classes="iconBtn" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.refresh}">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconRefresh}"/>
                    </Button>
                </StackPanel>
            </Grid>
            <WrapPanel IsVisible="{Binding ShowProject}">
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > Button"><Setter Property="Margin" Value="0,0,8,6"/></Style>
                </WrapPanel.Styles>
                <Button Classes="primary" Command="{Binding RestoreCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.restore}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr bpm.button.restore}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding LockCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.lock}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconPin}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr bpm.button.lock}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MountCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.mount}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconPackages}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr bpm.button.mount}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
                <TextBlock Text="{Binding Progress}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Click="OnClose" ToolTip.Tip="{loc:Tr bpm.tooltip.close}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr bpm.button.close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <Border CornerRadius="10" Padding="14,12" Background="#26F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" IsVisible="{Binding HasPlan}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding PlanHeading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Tr bpm.plan.intro}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding PlanChanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:BpmTemplateChange">
                                    <Grid ColumnDefinitions="90,*" Margin="0,2">
                                        <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="12"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Path}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Reason}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelPlanCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.cancelPlan}">
                                <TextBlock Text="{loc:Tr bpm.button.cancelPlan}"/>
                            </Button>
                            <Button Classes="primary" Command="{Binding ApplyPlanCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.applyPlan}">
                                <TextBlock Text="{loc:Tr bpm.button.applyPlan}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BpmMessageItem">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Panel Width="16" Margin="0,1,8,0" VerticalAlignment="Top">
                                    <PathIcon Width="14" Height="14" Data="{StaticResource IconWarning}" Foreground="{StaticResource BasisDangerBrush}" IsVisible="{Binding IsError}"/>
                                    <PathIcon Width="14" Height="14" Data="{StaticResource IconWarning}" Foreground="{StaticResource BasisWarningBrush}" IsVisible="{Binding IsWarning}"/>
                                    <PathIcon Width="14" Height="14" Data="{StaticResource IconInfo}" Classes="muted" IsVisible="{Binding IsInfo}"/>
                                    <PathIcon Width="14" Height="14" Data="{StaticResource IconCheck}" Foreground="{StaticResource BasisSuccessBrush}" IsVisible="{Binding IsDone}"/>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="card" Padding="16,14" IsVisible="{Binding ShowSetup}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr bpm.setup.heading}" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Tr bpm.setup.intro}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <RadioButton GroupName="bpmKind" IsChecked="{Binding SetupGame}" ToolTip.Tip="{loc:Tr bpm.tooltip.setupGame}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Tr bpm.setup.game}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr bpm.setup.gameText}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="bpmKind" IsChecked="{Binding SetupContent}" ToolTip.Tip="{loc:Tr bpm.tooltip.setupContent}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Tr bpm.setup.content}" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr bpm.setup.contentText}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="{loc:Tr bpm.setup.packages}" FontSize="12" IsVisible="{Binding SetupGame}"/>
                        <TextBox Text="{Binding SetupPackages}" Watermark="com.basis.framework, com.basis.sdk" IsVisible="{Binding SetupGame}"
                                 ToolTip.Tip="{loc:Tr bpm.tooltip.setupPackages}"/>
                        <TextBlock Text="{loc:Tr bpm.setup.at}" FontSize="12"/>
                        <TextBox Text="{Binding SetupAt}" ToolTip.Tip="{loc:Tr bpm.tooltip.setupAt}"/>
                        <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding SetupCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.setup}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="leadingIcon" Data="{StaticResource IconAdd}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr bpm.button.setup}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8" IsVisible="{Binding ShowProject}">
                    <TextBlock Text="{loc:Tr bpm.section.checkouts}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{loc:Tr bpm.checkouts.none}" Classes="muted" FontSize="12" IsVisible="{Binding !HasCheckouts}"/>
                    <ItemsControl ItemsSource="{Binding Checkouts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BpmCheckoutItem">
                                <Border Classes="glass" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Border Classes="versionPill" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr bpm.tooltip.held}">
                                                        <TextBlock Text="{Binding HeldText}" FontSize="11" Classes="muted"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="{Binding WhereText}"/>
                                                    <Run Text="  "/>
                                                    <Run Text="{Binding LockedText}" Foreground="{StaticResource BasisTextMutedBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ChangesText}" Foreground="{StaticResource BasisWarningBrush}" FontSize="12" IsVisible="{Binding HasChanges}"/>
                                                <TextBlock Text="{Binding Folder}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="iconBtn" VerticalAlignment="Top" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.openCheckout}">
                                                <PathIcon Width="16" Height="16" Data="{StaticResource IconFolderOpen}"/>
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPinned}">
                                            <TextBox Text="{Binding PinTarget}" Watermark="{loc:Tr bpm.pin.watermark}" ToolTip.Tip="{loc:Tr bpm.tooltip.pinTarget}"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding PinCommand}" ToolTip.Tip="{loc:Tr bpm.tooltip.pin}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconPin}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Tr bpm.button.pin}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Tr bpm.section.packages}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
                    <TextBlock Text="{loc:Tr bpm.packages.none}" Classes="muted" FontSize="12" IsVisible="{Binding !HasPackages}"/>
                    <ItemsControl ItemsSource="{Binding Packages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BpmPackageItem">
                                <Border Classes="glass" Padding="14,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LockedText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Requested}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MountText}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CopiedFromText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasCopiedFrom}"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Top" MaxWidth="360" HorizontalAlignment="Right">
                                            <WrapPanel.Styles>
                                                <Style Selector="WrapPanel > Button"><Setter Property="Margin" Value="6,0,0,6"/></Style>
                                            </WrapPanel.Styles>
                                            <Button Command="{Binding ToggleCommand}" IsVisible="{Binding IsListed}" ToolTip.Tip="{loc:Tr bpm.tooltip.toggle}">
                                                <TextBlock Text="{Binding ToggleText}"/>
                                            </Button>
                                            <Button Click="OnOverride" IsEnabled="{Binding CanSetOverrideNow}" IsVisible="{Binding CanOverride}" ToolTip.Tip="{loc:Tr bpm.tooltip.override}">
                                                <TextBlock Text="{loc:Tr bpm.button.override}"/>
                                            </Button>
                                            <Button Command="{Binding ClearOverrideCommand}" IsVisible="{Binding HasOverride}" ToolTip.Tip="{loc:Tr bpm.tooltip.clearOverride}">
                                                <TextBlock Text="{loc:Tr bpm.button.clearOverride}"/>
                                            </Button>
                                            <Button Command="{Binding EmbedCommand}" IsVisible="{Binding CanEmbed}" ToolTip.Tip="{loc:Tr bpm.tooltip.embed}">
                                                <TextBlock Text="{loc:Tr bpm.button.embed}"/>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
