<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.PackageUpdateWindow"
        x:DataType="vm:PackageUpdateViewModel"
        Title="{Binding Title}"
        Width="640" Height="620" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="26">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" Classes="h3"/>
            <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <Border Classes="glass" Padding="12,10" CornerRadius="8" IsVisible="{Binding HasLocalWork}">
                    <TextBlock Text="{loc:Tr dialog.packageUpdate.localWork}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#26F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" Padding="12,10" CornerRadius="8" IsVisible="{Binding HasSkipped}">
                    <TextBlock Text="{Binding SkippedText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BasisWarningBrush}"/>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.packageUpdate.loading}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BasisWarningBrush}"/>
                <TextBlock Text="{loc:Tr dialog.packageUpdate.nothing}" IsVisible="{Binding HasNothing}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                <StackPanel Spacing="8" IsVisible="{Binding HasReleases}">
                    <TextBlock Text="{loc:Tr dialog.packageUpdate.releases}" Classes="dim" FontSize="11" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding Releases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ReleaseNoteItem">
                                <Border Classes="card" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Date}" Classes="dim" FontSize="11" IsVisible="{Binding HasDate}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <SelectableTextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasCommits}">
                    <TextBlock Text="{loc:Tr dialog.packageUpdate.commits}" Classes="dim" FontSize="11" FontWeight="Bold"/>
                    <Border Classes="card" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding Commits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CommitItem">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding ShortSha}" FontFamily="{StaticResource MonoFontFamily}" Classes="dim" FontSize="11" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Subject}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding MoreCommitsText}" IsVisible="{Binding MoreCommits}" Classes="dim" FontSize="11"/>
                </StackPanel>
                <Button Classes="link" HorizontalAlignment="Left" IsVisible="{Binding HasCompareUrl}" Command="{Binding OpenCompareCommand}"
                        ToolTip.Tip="{loc:Tr dialog.packageUpdate.tooltip.compare}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource IconOpenExternal}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.packageUpdate.compare}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Click="OnCancel" ToolTip.Tip="{loc:Tr dialog.packageUpdate.tooltip.cancel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.packageUpdate.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="primary" Click="OnUpdate" ToolTip.Tip="{loc:Tr dialog.packageUpdate.tooltip.update}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconUpdate}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.packageUpdate.update}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
