<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        xmlns:views="using:BasisPM.App.Views"
        x:Class="BasisPM.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr shell.window.title}"
        Icon="/Assets/BasisLogo.png"
        Width="1240" Height="820"
        MinWidth="880" MinHeight="600"
        Background="{StaticResource BasisBackgroundBrush}">

    <Panel ClipToBounds="True">
        <views:AnimatedBackdrop/>

        <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto">

            <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="22,28,22,32" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9"
                                ClipToBounds="True"
                                BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="1">
                            <Image Source="/Assets/BasisLogo.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Spacing="-2">
                            <TextBlock Text="{loc:Tr shell.wordmark.name}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Tr shell.wordmark.tagline}" FontSize="11" Classes="muted"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="0" Margin="10,0">
                    <Grid>
                        <Button Classes="nav" Classes.active="{Binding IsCommunity}" Tag="community" Click="OnNavClick" HorizontalAlignment="Stretch" ToolTip.Tip="{loc:Tr nav.tooltip.community}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Width="18" Height="18" Data="{StaticResource IconHome}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr nav.community}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Classes="brandBadge" Padding="7,1" MinWidth="18"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                IsHitTestVisible="False"
                                IsVisible="{Binding HasUnreadAnnouncements}">
                            <TextBlock Text="{Binding AnnouncementsUnreadCount}"
                                       FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <Button Classes="nav" Classes.active="{Binding IsInstalls}" Tag="installs" Click="OnNavClick" HorizontalAlignment="Stretch" ToolTip.Tip="{loc:Tr nav.tooltip.installs}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Width="18" Height="18" Data="{StaticResource IconInstalls}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr nav.installs}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Classes="brandBadge" Padding="7,1" MinWidth="18"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                IsHitTestVisible="False"
                                IsVisible="{Binding HasBasisUpdates}">
                            <TextBlock Text="{Binding BasisUpdateCount}"
                                       FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button Classes="nav" Classes.active="{Binding IsUnity}" Tag="unity" Click="OnNavClick" ToolTip.Tip="{loc:Tr nav.tooltip.unity}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Width="18" Height="18" Data="{StaticResource IconUnity}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr nav.unity}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsSettings}" Tag="settings" Click="OnNavClick" ToolTip.Tip="{loc:Tr nav.tooltip.settings}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Width="18" Height="18" Data="{StaticResource IconSettings}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr nav.settings}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,0,22,22" Spacing="6">
                    <Rectangle Height="1" Fill="{StaticResource BasisBorderBrush}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                        <Border Classes="versionPill" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Tr shell.version.tooltip}">
                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="12" FontWeight="SemiBold" Classes="brand"/>
                        </Border>
                        <ComboBox ItemsSource="{Binding SettingsVM.Languages}"
                                  SelectedItem="{Binding SettingsVM.SelectedLanguage}"
                                  Width="112" MinHeight="28" Padding="8,2"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="{loc:Tr settings.tooltip.language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="loc:LanguageInfo">
                                    <TextBlock Text="{Binding NativeName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="basisvr.org" Classes="dim" FontSize="11"/>
                    <TextBlock Text="{loc:Tr shell.footer.license}" Classes="dim" FontSize="11"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0">
                <Border Classes="reveal"
                        IsVisible="{Binding UpdateAvailable}"
                        Background="{StaticResource BasisActionGradient}"
                        CornerRadius="12"
                        Padding="18,12" Margin="18,16,18,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateBannerText}"
                                       Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <ProgressBar Classes="bannerProgress" IsVisible="{Binding IsUpdating}"
                                         Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                         ShowProgressText="True"
                                         Foreground="#FFFFFF" Background="#33FFFFFF"
                                         Height="16" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                    Margin="16,0,0,0" VerticalAlignment="Center"
                                    IsVisible="{Binding !IsUpdating}">
                            <Button Classes="bannerPrimary"
                                    Command="{Binding InstallUpdateCommand}"
                                    ToolTip.Tip="{loc:Tr shell.update.nowTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr shell.update.now}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="bannerGhost" Content="{loc:Tr shell.update.later}"
                                    Command="{Binding DismissUpdateCommand}"
                                    ToolTip.Tip="{loc:Tr shell.update.laterTooltip}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="reveal"
                        IsVisible="{Binding BasisBannerVisible}"
                        Background="{StaticResource BasisSurfaceBrush}"
                        BorderBrush="{StaticResource BasisPurpleBrush}" BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12" Margin="18,16,18,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0" Width="18" Height="18" Data="{StaticResource IconUpdate}"
                                  Foreground="{StaticResource BasisActionTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding BasisBannerText}"
                                   FontWeight="SemiBold" FontSize="13"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                    Margin="16,0,0,0" VerticalAlignment="Center">
                            <Button Classes="primary"
                                    Command="{Binding ReviewBasisUpdateCommand}"
                                    ToolTip.Tip="{loc:Tr shell.basisUpdate.reviewTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconUpdate}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BasisBannerAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="{loc:Tr shell.basisUpdate.later}"
                                    Command="{Binding DismissBasisUpdateCommand}"
                                    ToolTip.Tip="{loc:Tr shell.basisUpdate.laterTooltip}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>

                <!-- Cross-fade the content when switching nav tabs instead of snapping between views. -->
                <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentView}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.18"/>
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>

                <!-- Cross-page operation cards stay visible while the user changes tabs. -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,24,24" Width="330" Spacing="10">
                    <Border Classes="reveal" IsVisible="{Binding IsActivityVisible}"
                            Padding="16,13" CornerRadius="12"
                            Background="{StaticResource BasisSurfaceBrush}"
                            BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="1"
                            ToolTip.Tip="{loc:Tr shell.tooltip.activityCard}">
                        <StackPanel Spacing="9">
                            <Border Classes="versionPill" HorizontalAlignment="Left" IsVisible="{Binding CurrentActivity.HasProject}" ToolTip.Tip="{loc:Tr shell.tooltip.activityProject}">
                                <TextBlock Text="{Binding CurrentActivity.Project}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconDownload}"
                                          Foreground="{StaticResource BasisActionTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentActivity.Title}" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding CurrentActivity.Progress}"
                                         IsIndeterminate="{Binding CurrentActivity.IsIndeterminate}"
                                         Height="7" CornerRadius="4"/>
                            <TextBlock Text="{Binding CurrentActivity.Detail}" Classes="dim" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding CurrentActivity.HasDetail}"/>
                            <Button Classes="link" HorizontalAlignment="Left" Padding="0" Command="{Binding ShowActivitiesCommand}"
                                    IsVisible="{Binding HasMoreActivities}" ToolTip.Tip="{loc:Tr shell.activity.moreTooltip}">
                                <TextBlock Text="{Binding MoreActivitiesLabel}" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Package installs have their own queue count and per-clone percentage. -->
                    <Border Classes="reveal" IsVisible="{Binding PackagesVM.IsInstalling}"
                            Padding="16,13" CornerRadius="12"
                            Background="{StaticResource BasisSurfaceBrush}"
                            BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="1"
                            ToolTip.Tip="{loc:Tr shell.tooltip.installCard}">
                        <StackPanel Spacing="9">
                            <Border Classes="versionPill" HorizontalAlignment="Left" IsVisible="{Binding PackagesVM.HasInstallProject}" ToolTip.Tip="{loc:Tr shell.tooltip.installProject}">
                                <TextBlock Text="{Binding PackagesVM.InstallProject}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconDownload}"
                                          Foreground="{StaticResource BasisActionTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PackagesVM.InstallProgressText}" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding PackagesVM.InstallProgress}"
                                         IsIndeterminate="{Binding PackagesVM.InstallProgressIndeterminate}"
                                         Height="7" CornerRadius="4"/>
                            <TextBlock Text="{Binding PackagesVM.InstallProgressDetail}" Classes="dim" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding PackagesVM.HasInstallProgressDetail}"/>
                            <TextBlock Text="{Binding PackagesVM.InstallQueueLabel}" Classes="muted" FontSize="11"
                                       IsVisible="{Binding PackagesVM.HasInstallQueue}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                    Background="#A0100F27"
                    BorderBrush="{StaticResource BasisBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,9">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0" Classes="versionPill" Margin="0,0,10,0" VerticalAlignment="Center"
                            IsVisible="{Binding HasStatusProject}" ToolTip.Tip="{loc:Tr shell.status.projectTooltip}">
                        <TextBlock Text="{Binding StatusProject}" FontSize="11" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Classes="muted"
                               Classes.statusError="{Binding IsStatusError}"
                               Classes.statusSuccess="{Binding IsStatusSuccess}"
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                                IsVisible="{Binding CanCopyStatus}">
                        <Button Classes="primary" Padding="10,6" MinWidth="0" CornerRadius="10" IsVisible="{Binding CanFixStatus}"
                                Command="{Binding FixStatusCommand}"
                                ToolTip.Tip="{Binding FixStatusTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="13" Height="13" Data="{StaticResource IconCheck}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr shell.status.fix}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="10,6" MinWidth="0" CornerRadius="10" IsVisible="{Binding CanRetryStatus}"
                                Command="{Binding RetryStatusCommand}"
                                ToolTip.Tip="{loc:Tr shell.status.retryTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="13" Height="13" Data="{StaticResource IconRefresh}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr shell.status.retry}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="iconBtn sm"
                                Click="OnCopyStatusClick"
                                ToolTip.Tip="{loc:Tr shell.status.copyTooltip}">
                            <PathIcon Width="15" Height="15" Data="{StaticResource IconCopy}"/>
                        </Button>
                        <Button Classes="iconBtn sm"
                                IsVisible="{Binding IsStatusError}"
                                Command="{Binding OpenIssueCommand}"
                                ToolTip.Tip="{loc:Tr shell.status.openIssueTooltip}">
                            <PathIcon Width="15" Height="15" Data="{StaticResource IconOpenExternal}"/>
                        </Button>
                        <Button Classes="iconBtn sm"
                                Click="OnDismissStatusClick"
                                ToolTip.Tip="{loc:Tr shell.status.okTooltip}">
                            <PathIcon Width="15" Height="15" Data="{StaticResource IconClose}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>
