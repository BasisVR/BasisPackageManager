<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BasisPM.App.ViewModels"
             xmlns:loc="using:BasisPM.App.Localization"
             xmlns:views="using:BasisPM.App.Views"
             x:Class="BasisPM.App.Views.InstallsView"
             x:DataType="vm:InstallsViewModel"
             Name="Root">

    <UserControl.Styles>
        <!-- A card's name reads as its heading until hovered or clicked, then edits in place. -->
        <Style Selector="TextBox.inlineName">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="-7,-3,0,-3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MaxLength" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.inlineName:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BasisSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BasisBorderBrush}"/>
        </Style>
        <Style Selector="TextBox.inlineName:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource BasisSurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BasisActionTextBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="28,20,28,28" Spacing="18">

            <Border CornerRadius="14" Padding="32,28" Background="{StaticResource BasisHeroGradient}"
                    BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr installs.hero.tagline}" Classes="tagline"/>
                            <TextBlock Text="{loc:Tr installs.hero.title}" Classes="h1" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr installs.hero.subtitle}"
                                       Classes="muted" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Name="AdvancedToggle" views:SectionState.Key="projects.advanced" VerticalAlignment="Top" Margin="16,0,0,0" ToolTip.Tip="{loc:Tr installs.tooltip.advanced}" Content="{loc:Tr shell.button.advanced}"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,-10">
                        <WrapPanel.Styles>
                            <Style Selector="Button"><Setter Property="Margin" Value="0,0,10,10"/></Style>
                        </WrapPanel.Styles>
                        <Button Classes="primary" Command="{Binding NewProjectCommand}" ToolTip.Tip="{loc:Tr installs.tooltip.newProject}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="leadingIcon" Data="{StaticResource IconFolderOpen}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr installs.button.newProject}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddExistingCommand}" ToolTip.Tip="{loc:Tr installs.tooltip.addExisting}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="leadingIcon" Data="{StaticResource IconFolderOpen}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr installs.button.addExisting}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FindProjectsCommand}" ToolTip.Tip="{loc:Tr installs.tooltip.findProjects}"
                                IsVisible="{Binding #AdvancedToggle.IsChecked}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="leadingIcon" Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr installs.button.findProjects}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding UpdateAllCommand}" ToolTip.Tip="{loc:Tr installs.tooltip.updateAll}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Installs.Count" Converter="{x:Static vm:Converters.IntNonZero}"/>
                                    <Binding ElementName="AdvancedToggle" Path="IsChecked"/>
                                </MultiBinding>
                            </Button.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="leadingIcon" Data="{StaticResource IconUpdate}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr installs.button.updateAll}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="iconBtn" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Tr installs.tooltip.refresh}">
                            <PathIcon Width="16" Height="16" Data="{StaticResource IconRefresh}"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- One compact row per project, sized like a package row. -->
            <Border Classes="card" Padding="0,6" IsVisible="{Binding Installs.Count, Converter={x:Static vm:Converters.IntNonZero}}">
                <ItemsControl ItemsSource="{Binding Installs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:InstallRow">
                            <Border Classes="glass reveal" Padding="14,8" Margin="16,3">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{StaticResource BasisBrandGradient}">
                                            <PathIcon Width="14" Height="14" Data="{StaticResource IconInstalls}" Foreground="#FFFFFF"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Classes="inlineName" Text="{Binding Name, Mode=OneWay}" MaxWidth="260" Margin="4,0,0,0"
                                                 LostFocus="OnNameLostFocus" ToolTip.Tip="{loc:Tr installs.tooltip.rename}"/>
                                        <WrapPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RepoRoot}" Classes="dim" FontSize="12" MaxWidth="300" Margin="0,2,10,2"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding RepoRoot}"/>
                                            <Border Background="{StaticResource BasisPanelBrush}"
                                                    BorderBrush="{StaticResource BasisBorderBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,2,8,2" VerticalAlignment="Center"
                                                    ToolTip.Tip="{loc:Tr installs.tooltip.unityVersion}">
                                                <TextBlock Text="{Binding UnityVersionLabel}" FontSize="11"
                                                           Foreground="{StaticResource BasisAccentBrush}"/>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" IsVisible="{Binding #AdvancedToggle.IsChecked}" ToolTip.Tip="{Binding BranchTooltip}">
                                                <TextBlock Text="{Binding BranchCommit}" FontSize="11" Classes="muted"
                                                           MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" ToolTip.Tip="{loc:Tr installs.tooltip.localChanges}">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="HasLocalChanges"/>
                                                        <Binding ElementName="AdvancedToggle" Path="IsChecked"/>
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <TextBlock Text="{Binding ChangeCount, StringFormat='{}{0} changed'}"
                                                           FontSize="11" Classes="brand" FontWeight="Bold"/>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" ToolTip.Tip="{loc:Tr installs.row.leftOutTip}">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="HasLeftOutParts"/>
                                                        <Binding ElementName="AdvancedToggle" Path="IsChecked"/>
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <TextBlock Text="{Binding LeftOutText}" FontSize="11" Classes="muted"/>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" IsVisible="{Binding TeamHasUpdates}"
                                                    ToolTip.Tip="{loc:Tr installs.team.tooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Width="11" Height="11" Data="{StaticResource IconDownload}"
                                                              Foreground="{StaticResource BasisActionTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TeamPillText}" FontSize="11" Classes="brand" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" IsVisible="{Binding BasisUpdateAvailable}"
                                                    ToolTip.Tip="{Binding BasisPillTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Width="11" Height="11" Data="{StaticResource IconUpdate}"
                                                              Foreground="{StaticResource BasisActionTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BasisPillText}" FontSize="11" Classes="brand" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" IsVisible="{Binding BasisUpdateInProgress}"
                                                    ToolTip.Tip="{Binding UpdateButtonTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Width="11" Height="11" Data="{StaticResource IconWarning}"
                                                              Foreground="{StaticResource BasisWarningBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BasisPillText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource BasisWarningBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="versionPill" Margin="0,2,8,2" IsVisible="{Binding BasisPillMuted}"
                                                    ToolTip.Tip="{Binding BasisPillTooltip}">
                                                <TextBlock Text="{Binding BasisPillText}" FontSize="11" Classes="muted"/>
                                            </Border>
                                        </WrapPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Classes="primary" FontSize="12" Padding="12,6" IsVisible="{Binding HasUnityProject}"
                                                    Command="{Binding #Root.((vm:InstallsViewModel)DataContext).OpenInUnityCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{loc:Tr installs.tooltip.openInUnity}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Width="12" Height="12" Data="{StaticResource IconPlay}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Tr develop.button.openInUnity}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button FontSize="12" Padding="12,6"
                                                    Command="{Binding #Root.((vm:InstallsViewModel)DataContext).ManagePackagesCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{loc:Tr installs.tooltip.manageProject}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Width="12" Height="12" Data="{StaticResource IconPackages}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Tr installs.button.manageProject}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding GitSummary}" Classes="muted" FontSize="12" Margin="38,0,0,0" TextWrapping="Wrap"
                                               IsVisible="{Binding #AdvancedToggle.IsChecked}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Classes="card" IsVisible="{Binding Installs.Count, Converter={x:Static vm:Converters.IntZero}}">
                <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,40">
                    <TextBlock Text="{loc:Tr installs.empty.title}" Classes="h3" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr installs.empty.body}"
                               Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
