<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.LicensesWindow"
        x:DataType="vm:LicensesViewModel"
        Title="{loc:Tr dialog.licenses.title}"
        Width="720" Height="620" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <DockPanel Margin="26,24">
        <StackPanel DockPanel.Dock="Top" Spacing="12">
            <TextBlock Text="{Binding Heading}" Classes="h3" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Tr dialog.licenses.intro}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconWarning}" Foreground="{StaticResource BasisWarningBrush}"
                                  VerticalAlignment="Center" IsVisible="{Binding HasWarnings}"/>
                        <TextBlock Text="{Binding SummaryText}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" CornerRadius="2"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <CheckBox Content="{loc:Tr dialog.licenses.includeUnity}" IsChecked="{Binding IncludeUnity}"
                              ToolTip.Tip="{loc:Tr dialog.licenses.tooltip.includeUnity}"/>
                    <Button Classes="iconBtn" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Tr dialog.licenses.tooltip.refresh}">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconRefresh}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasInfoStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasErrorStatus}" Foreground="{StaticResource BasisDangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Click="OnClose" ToolTip.Tip="{loc:Tr dialog.licenses.tooltip.close}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.licenses.close}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnCopy" IsEnabled="{Binding CanExport}" ToolTip.Tip="{loc:Tr dialog.licenses.tooltip.copy}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconCopy}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.licenses.copy}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" Click="OnSave" IsEnabled="{Binding CanExport}" ToolTip.Tip="{loc:Tr dialog.licenses.tooltip.save}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconSave}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.licenses.save}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Border Classes="card" Padding="0" Margin="0,8,0,0" ClipToBounds="True">
            <Panel>
                <ScrollViewer IsVisible="{Binding HasRows}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LicenseRow">
                                <Border Padding="14,10" BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <PathIcon Grid.Column="1" Width="14" Height="14" Margin="12,0,0,0" Data="{StaticResource IconWarning}"
                                                  Foreground="{StaticResource BasisWarningBrush}" VerticalAlignment="Center"
                                                  IsVisible="{Binding HasConcern}" ToolTip.Tip="{Binding ConcernText}"/>
                                        <Border Grid.Column="2" Classes="versionPill" Margin="10,0,0,0" VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding LicenseTooltip}">
                                            <TextBlock Text="{Binding LicenseText}" FontSize="11" FontWeight="SemiBold" Classes="muted"
                                                       MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock IsVisible="{Binding ShowEmpty}" Text="{loc:Tr dialog.licenses.none}"
                           Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"/>
            </Panel>
        </Border>
    </DockPanel>
</Window>
