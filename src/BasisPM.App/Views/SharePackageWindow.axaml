<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.SharePackageWindow"
        x:DataType="vm:SharePackageViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <StackPanel Margin="26,24" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Title}" Classes="h3"/>
            <TextBlock Text="{Binding Body}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr dialog.share.branch}" Classes="dim" FontSize="11" FontWeight="Bold"/>
            <TextBox x:Name="BranchBox" Text="{Binding Branch}" ToolTip.Tip="{loc:Tr dialog.share.tooltip.branch}"/>
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding NeedsMessage}">
            <TextBlock Text="{loc:Tr dialog.share.message}" Classes="dim" FontSize="11" FontWeight="Bold"/>
            <TextBox x:Name="CommitMessageBox" Text="{Binding Message}" Watermark="{loc:Tr dialog.share.messageWatermark}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" ToolTip.Tip="{loc:Tr dialog.share.tooltip.message}"/>
        </StackPanel>
        <TextBlock Text="{loc:Tr dialog.share.note}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource BasisWarningBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="OnCancel" ToolTip.Tip="{loc:Tr dialog.share.tooltip.cancel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.share.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="primary" Click="OnShare" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{loc:Tr dialog.share.tooltip.share}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconBranch}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.share.share}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
