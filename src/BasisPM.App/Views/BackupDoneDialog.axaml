<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.BackupDoneDialog"
        Title="{loc:Tr dialog.backupDone.title}"
        SizeToContent="WidthAndHeight" MinWidth="480" MaxWidth="720"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <StackPanel Margin="26,24" Spacing="18">
        <TextBlock Text="{loc:Tr dialog.backupDone.title}" Classes="h3"/>
        <StackPanel Spacing="6">
            <TextBlock x:Name="MessageText" Classes="muted" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
            <TextBlock x:Name="PathText" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
        </StackPanel>
        <TextBlock x:Name="QuestionText" Classes="muted" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="OnClose" ToolTip.Tip="{loc:Tr dialog.confirm.tooltip.no}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.confirm.no}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="primary" Click="OnShow" ToolTip.Tip="{loc:Tr dialog.backupDone.tooltip.show}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconFolderOpen}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ShowText" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
