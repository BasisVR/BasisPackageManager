<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.UnityChangeBackupDialog"
        Title="{loc:Tr dialog.unityBackup.title}"
        SizeToContent="WidthAndHeight" MinWidth="520" MaxWidth="760"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <StackPanel Margin="26,24" Spacing="16">
        <TextBlock Text="{loc:Tr dialog.unityBackup.heading}" Classes="h3"/>
        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/>
        <Border Classes="card" Padding="14,12" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr dialog.unityBackup.risksTitle}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{loc:Tr dialog.unityBackup.riskUpgrade}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:Tr dialog.unityBackup.riskNoUndo}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:Tr dialog.unityBackup.riskWhatsSaved}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Spacing="6" MaxWidth="560" HorizontalAlignment="Stretch">
            <TextBlock Text="{loc:Tr dialog.unityBackup.where}" FontWeight="SemiBold" FontSize="13"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="FolderBox" TextChanged="OnFolderChanged" ToolTip.Tip="{loc:Tr dialog.unityBackup.tooltip.folder}"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Click="OnBrowse" ToolTip.Tip="{loc:Tr dialog.unityBackup.tooltip.browse}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconFolderOpen}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.unityBackup.browse}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="OnCancel" ToolTip.Tip="{loc:Tr dialog.unityBackup.tooltip.cancel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.backup.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Content="{loc:Tr dialog.backup.continueWithout}" Click="OnContinue" ToolTip.Tip="{loc:Tr dialog.unityBackup.tooltip.continueWithout}"/>
            <Button x:Name="BackupButton" Classes="primary" Click="OnBackup" ToolTip.Tip="{loc:Tr dialog.unityBackup.tooltip.backup}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconArchive}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.backup.backupContinue}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
