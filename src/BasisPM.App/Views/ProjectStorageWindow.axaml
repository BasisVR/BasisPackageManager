<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.ProjectStorageWindow"
        x:Name="Root"
        x:DataType="vm:ProjectStorageViewModel"
        Title="{Binding Title}"
        Width="680" Height="640" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <DockPanel Margin="26,24">
        <StackPanel DockPanel.Dock="Top" Spacing="12">
            <TextBlock Text="{Binding Heading}" Classes="h3" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Tr dialog.storage.intro}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsMeasuring}" Height="4" CornerRadius="2"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Command="{Binding StopCommand}" IsVisible="{Binding IsMeasuring}" ToolTip.Tip="{loc:Tr dialog.storage.tooltip.stop}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr dialog.storage.stop}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="iconBtn" Command="{Binding RefreshCommand}" IsVisible="{Binding IsIdle}" ToolTip.Tip="{loc:Tr dialog.storage.tooltip.refresh}">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconRefresh}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasInfoStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasErrorStatus}" Foreground="{StaticResource BasisDangerBrush}" FontSize="12" TextWrapping="Wrap"/>
            <Button Click="OnClose" HorizontalAlignment="Right" ToolTip.Tip="{loc:Tr dialog.storage.tooltip.close}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.storage.close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Margin="0,8,0,0">
            <StackPanel Spacing="14">
                <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasRows}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageRow">
                                <Border Padding="14,10" BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="70" TextAlignment="Right"/>
                                        <Panel Grid.Column="2" Margin="12,0,0,0" MinWidth="78" VerticalAlignment="Center">
                                            <Button Command="{Binding Action}" IsVisible="{Binding HasSafeAction}" HorizontalAlignment="Right"
                                                    IsEnabled="{Binding #Root.((vm:ProjectStorageViewModel)DataContext).IsIdle}"
                                                    Content="{Binding ActionLabel}" ToolTip.Tip="{Binding ActionTooltip}"/>
                                            <Button Classes="danger" Command="{Binding Action}" IsVisible="{Binding HasDangerAction}" HorizontalAlignment="Right"
                                                    IsEnabled="{Binding #Root.((vm:ProjectStorageViewModel)DataContext).IsIdle}"
                                                    Content="{Binding ActionLabel}" ToolTip.Tip="{Binding ActionTooltip}"/>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Spacing="8" IsVisible="{Binding HasClones}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr dialog.storage.clonesHeading}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr dialog.storage.clonesIntro}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RemoveClonesCommand}" IsVisible="{Binding HasUnusedClones}" IsEnabled="{Binding IsIdle}"
                                Content="{Binding RemoveClonesLabel}" ToolTip.Tip="{loc:Tr dialog.storage.tooltip.removeClones}"/>
                    </Grid>
                    <Border Classes="card" Padding="0" ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Clones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StorageCloneRow">
                                    <Border Padding="14,8" BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding State}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
