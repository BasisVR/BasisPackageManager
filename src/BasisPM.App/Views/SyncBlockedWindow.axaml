<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.SyncBlockedWindow"
        x:DataType="vm:SyncBlockedViewModel"
        Title="{loc:Tr dialog.syncBlocked.title}"
        Width="680" Height="640" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <DockPanel Margin="26,24">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
            <TextBlock Text="{Binding Heading}" Classes="h3" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Intro}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
            <Border Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.keep.title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.keep.text}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Click="OnKeepMine" ToolTip.Tip="{loc:Tr dialog.syncBlocked.tooltip.keep}">
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.keep.button}"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.theirs.title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.theirs.text}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Click="OnTakeTheirs" ToolTip.Tip="{loc:Tr dialog.syncBlocked.tooltip.theirs}">
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.theirs.button}"/>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OnCancel" ToolTip.Tip="{loc:Tr dialog.syncBlocked.tooltip.cancel}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.syncBlocked.cancel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Border Classes="card" Padding="0" ClipToBounds="True">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr dialog.syncBlocked.files}" FontWeight="SemiBold" FontSize="12" Margin="14,10,14,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="14,0,14,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
