<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.BasisUpdateWindow"
        x:DataType="vm:BasisUpdateReviewViewModel"
        Title="{Binding HeaderText}"
        Width="640" Height="680" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="26">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="{Binding HeaderText}" Classes="h2"/>
            <TextBlock Text="{Binding Subtitle}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="glass" Padding="14,10" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconBranch}"
                                  Foreground="{StaticResource BasisBrandBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.branchLabel}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BasisBranch}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr dialog.basisUpdate.source}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Click="OnChangeBranch" IsEnabled="{Binding CanChangeBranch}" IsVisible="{Binding ShowChangeBranch}"
                        VerticalAlignment="Center" Margin="12,0,0,0"
                        ToolTip.Tip="{loc:Tr dialog.basisUpdate.tooltip.changeBranch}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="leadingIcon" Data="{StaticResource IconBranch}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.changeBranch}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Panel Grid.Row="2">
            <ScrollViewer IsVisible="{Binding !IsWorking}">
                <StackPanel Spacing="16" Margin="0,0,6,0">

                    <StackPanel Spacing="16" IsVisible="{Binding IsUpdate}">
                        <TextBlock Text="{Binding SwitchSummary}" IsVisible="{Binding IsSwitch}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Border Classes="versionPill" Margin="0,0,8,6" IsVisible="{Binding HasIncoming}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource IconUpdate}"
                                              Foreground="{StaticResource BasisBrandBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IncomingLabel}" Classes="brand" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="versionPill" Margin="0,0,8,6" IsVisible="{Binding HasOutgoing}">
                                <TextBlock Text="{Binding OutgoingLabel}" Classes="muted" FontSize="12"/>
                            </Border>
                            <Border Classes="versionPill" Margin="0,0,8,6" IsVisible="{Binding HasLocalCommits}">
                                <TextBlock Text="{Binding LocalCommitsLabel}" Classes="muted" FontSize="12"/>
                            </Border>
                            <Border Classes="versionPill" Margin="0,0,8,6" IsVisible="{Binding HasUncommitted}">
                                <TextBlock Text="{Binding UncommittedLabel}" Classes="muted" FontSize="12"/>
                            </Border>
                        </WrapPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconCheck}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisSuccessBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding ModeNote}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsSeparateHistory}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconCheck}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisSuccessBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding SeparateHistoryNote}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasMatch}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconTag}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisBlueBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding MatchText}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasLayout}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconInfo}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisBlueBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding LayoutNote}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasUncommitted}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconCheck}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisSuccessBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr dialog.basisUpdate.note.uncommitted}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasColliding}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconInfo}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisBlueBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding CollidingNote}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasReplacedMeta}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconInfo}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisBlueBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding ReplacedMetaNote}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding PredictionUnknown}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconInfo}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisBlueBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr dialog.basisUpdate.note.conflictsUnknown}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding UnityOpen}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconWarning}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisWarningBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr dialog.basisUpdate.note.unity}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource BasisWarningBrush}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding HasPredictedConflicts}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconWarning}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisWarningBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding PredictedNote}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Border Classes="glass" Padding="12,8">
                                <ItemsControl ItemsSource="{Binding PredictedConflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                       Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding HasBlocking}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Width="14" Height="14" Data="{StaticResource IconWarning}" Margin="0,2,10,0"
                                          Foreground="{StaticResource BasisDangerBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr dialog.basisUpdate.note.blocking}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource BasisDangerBrush}"/>
                            </Grid>
                            <Border Classes="glass" Padding="12,8">
                                <ItemsControl ItemsSource="{Binding BlockingPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                       Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding HasCommits}">
                            <TextBlock Text="{loc:Tr dialog.basisUpdate.whatsNew}" Classes="h3"/>
                            <Border Classes="glass" Padding="6">
                                <ItemsControl ItemsSource="{Binding Commits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BasisCommitRow">
                                            <Grid ColumnDefinitions="Auto,*" Margin="8,6">
                                                <TextBlock Grid.Column="0" Text="{Binding ShortSha}" Classes="brand"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                           Margin="0,1,12,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Subject}" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{Binding MoreCommitsLabel}" IsVisible="{Binding HasMoreCommits}" Classes="dim" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsUpToDate}" Margin="0,24,0,0" HorizontalAlignment="Center">
                        <PathIcon Width="34" Height="34" Data="{StaticResource IconCheck}" Foreground="{StaticResource BasisSuccessBrush}"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.upToDate.title}" Classes="h3" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UpToDateBody}" Classes="muted" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="460"/>
                        <TextBlock Text="{Binding MatchText}" IsVisible="{Binding HasMatch}" Classes="dim" FontSize="12" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="460"/>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsUnrelated}">
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.unrelated.title}" Classes="h3"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.unrelated.body}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.unrelated.noMatch}"
                                   Foreground="{StaticResource BasisWarningBrush}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsNotGit}">
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.notGit.title}" Classes="h3"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.notGit.body}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Tr dialog.basisUpdate.notGit.first}" Classes="dim" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsBlocked}">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconWarning}" Margin="0,2,10,0"
                                  Foreground="{StaticResource BasisWarningBrush}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding BlockText}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsWorking}" Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="6" CornerRadius="3"/>
                <TextBlock Text="{loc:Tr dialog.basisUpdate.working}" Classes="muted" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Panel>

        <CheckBox Grid.Row="3" IsVisible="{Binding ShowBackup}" IsChecked="{Binding Backup}"
                  Content="{loc:Tr dialog.basisUpdate.backup}" Margin="0,14,0,0"
                  ToolTip.Tip="{loc:Tr dialog.basisUpdate.tooltip.backup}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Click="OnCancel" ToolTip.Tip="{loc:Tr dialog.basisUpdate.tooltip.cancel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CancelLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="cta" Click="OnPrimary" IsVisible="{Binding HasPrimary}" IsEnabled="{Binding !IsWorking}"
                    ToolTip.Tip="{loc:Tr dialog.basisUpdate.tooltip.primary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconUpdate}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
