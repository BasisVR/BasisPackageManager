<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasisPM.App.ViewModels"
        xmlns:loc="using:BasisPM.App.Localization"
        x:Class="BasisPM.App.Views.CloneBasisWindow"
        x:DataType="vm:CloneBasisViewModel"
        Title="{loc:Tr dialog.cloneBasis.title}"
        Width="540" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BasisBackgroundBrush}">
    <StackPanel Margin="26,24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr dialog.cloneBasis.heading}" Classes="h3"/>
            <TextBlock Text="{Binding Folder}" Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}"/>
        </StackPanel>
        <TextBlock Text="{loc:Tr dialog.cloneBasis.intro}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
        <Border Classes="card" Padding="0" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Parts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PartOption">
                        <Border Padding="14,10" BorderBrush="{StaticResource BasisBorderBrush}" BorderThickness="0,0,0,1">
                            <CheckBox IsChecked="{Binding IsIncluded}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Location}" Classes="dim" FontSize="11" IsVisible="{Binding ShowsLocation}"/>
                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Text="{loc:Tr dialog.cloneBasis.remembered}" Classes="dim" FontSize="11" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="OnCancel" ToolTip.Tip="{loc:Tr dialog.cloneBasis.tooltip.cancel}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconClose}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.cloneBasis.cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Classes="primary" Click="OnClone" ToolTip.Tip="{loc:Tr dialog.cloneBasis.tooltip.clone}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="leadingIcon" Data="{StaticResource IconDownload}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr dialog.cloneBasis.clone}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
